<window title="Demo 安装程序" width="900" height="620" theme="light">
  <!-- ==================== 语言选择页（第一步：先选语言，界面与安装产物全程跟随） ==================== -->
  <page id="locale" title="选择语言" title-i18n="page.locale">
    <column gap="16" padding="48">
      <text size="28" weight="bold" i18n="locale.title" animate="fade-in 400ms">选择安装语言</text>
      <text size="14" color="#888" i18n="locale.hint" animate="fade-in 500ms">安装程序界面将使用所选语言，安装后的程序也将跟随此语言。默认跟随系统语言。</text>
      <select id="locale" options="zh-CN=简体中文,en-US=English"/>
      <spacer/>
      <row gap="8" align="end" animate="fade-in 700ms">
        <button action="next" primary="true" i18n="button.next">下一步</button>
        <button action="cancel" i18n="button.cancel">取消</button>
      </row>
    </column>
  </page>

  <!-- ==================== 欢迎页（图层演示：bg 背景层 + fg 前景层叠加） ==================== -->
  <page id="welcome" title="欢迎" title-i18n="page.welcome">
    <layer id="bg" bg="#1f6feb">
      <image src="resources/banner.png" width="260" height="620"/>
    </layer>
    <layer id="fg">
      <row>
        <spacer width="260"/>
        <column gap="14" padding="40">
          <text size="30" weight="bold" i18n="welcome.title" animate="fade-in 400ms">Demo 安装程序</text>
          <text color="#888" size="14" i18n="welcome.subtitle" animate="fade-in 500ms">版本 1.0.0 · 由语义化安装引擎驱动</text>
          <spacer/>
          <text size="15" i18n="welcome.body" animate="slide-up 500ms">欢迎使用 Demo。本安装程序基于类 HTML 语义标签
渲染引擎构建，全部界面由 app.ui 一份标记文件定义。
点击“下一步”开始安装。</text>
          <spacer/>
          <row gap="8" align="end" animate="fade-in 700ms">
            <button action="next" primary="true" i18n="button.next">下一步</button>
            <button action="cancel" i18n="button.cancel">取消</button>
          </row>
        </column>
      </row>
    </layer>
  </page>

  <!-- ==================== 许可协议页 ==================== -->
  <page id="license" title="许可协议" title-i18n="page.license">
    <column gap="12" padding="44">
      <text size="24" weight="bold" i18n="license.title">最终用户许可协议</text>
      <divider/>
      <label size="13" color="#666" i18n="license.hint">请阅读以下协议，勾选同意后继续。</label>
      <text id="license-body" size="14" color="#444">MIT License

Copyright (c) 2026 Semantic Installer Contributors

Permission is hereby granted, free of charge, to any person obtaining a copy
of this software and associated documentation files (the "Software"), to deal
in the Software without restriction, including without limitation the rights
to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
copies of the Software, and to permit persons to whom the Software is
furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all
copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.</text>
      <spacer/>
      <checkbox id="accept-license" required="true" i18n="license.accept">我已阅读并同意上述许可协议</checkbox>
      <row gap="8" align="end">
        <button action="back" i18n="button.back">上一步</button>
        <button action="next" primary="true" i18n="button.agree">我同意，继续</button>
        <button action="cancel" i18n="button.cancel">取消</button>
      </row>
    </column>
  </page>

  <!-- ==================== 安装选项页 ==================== -->
  <page id="options" title="安装选项" title-i18n="page.options">
    <column gap="14" padding="44">
      <text size="24" weight="bold" i18n="options.title">安装选项</text>
      <text color="#888" size="13" i18n="options.hint">选择安装类型与安装位置。</text>

      <radio group="install-type" value="typical" checked="true" i18n="options.type.typical">典型安装（推荐）</radio>
      <radio group="install-type" value="custom" i18n="options.type.custom">自定义安装</radio>

      <text size="14" weight="bold" i18n="options.dir">安装目录</text>
      <input id="install-dir" placeholder="$LOCALAPPDATA/Demo App" browse="true"/>

      <checkbox id="create-shortcut" checked="true" i18n="options.shortcut">创建桌面快捷方式</checkbox>

      <text size="14" weight="bold" i18n="options.language">界面语言</text>
      <select id="locale" options="zh-CN=简体中文,en-US=English"/>

      <spacer/>
      <row gap="8" align="end">
        <button action="back" i18n="button.back">上一步</button>
        <button action="install" primary="true" i18n="button.install">安装</button>
        <button action="cancel" i18n="button.cancel">取消</button>
      </row>
    </column>
  </page>

  <!-- ==================== 安装进度页 ==================== -->
  <page id="progress" title="正在安装" title-i18n="page.progress">
    <column gap="16" padding="44">
      <text size="24" weight="bold" i18n="progress.title" animate="fade-in 300ms">正在安装…</text>
      <progress id="progress"/>
      <spacer/>
      <text id="progress-hint" size="13" color="#999" i18n="progress.hint" animate="pulse 1500ms infinite">请勿关闭窗口。</text>
    </column>
  </page>

  <!-- ==================== 完成页 ==================== -->
  <page id="finish" title="安装完成" title-i18n="page.finish">
    <column gap="14" padding="44">
      <text size="24" weight="bold" i18n="finish.title" animate="fade-in 300ms">安装完成</text>
      <text color="#666" i18n="finish.done" animate="slide-up 400ms">Demo 已成功安装到您的计算机。</text>
      <text size="13" color="#999" i18n="finish.uninstall.hint" animate="fade-in 600ms">已创建卸载入口（可通过“控制面板 → 程序和功能”卸载）。</text>
      <spacer/>
      <row gap="8" align="end" animate="scale-in 300ms">
        <button action="finish" primary="true" i18n="button.finish">完成</button>
      </row>
    </column>
  </page>
</window>
